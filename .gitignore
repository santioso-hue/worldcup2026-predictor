# Entornos / cachés
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Artefactos de build (regenerables; no son fuente de verdad).
build/
*.egg-info/

# Secretos: NUNCA commitear la API key
.env

# Datos derivados y de corrida (regenerables): no se versionan. El único dato de
# entrada versionado es data/raw/annex_c_2026.json (derivado del reglamento, no
# descargable).
data/processed/*
!data/processed/.gitkeep

# Outputs: versionar solo los "finales" a mano; el resto se ignora.
outputs/figures/*
outputs/videos/*
!outputs/figures/.gitkeep
!outputs/videos/.gitkeep

# OS
.DS_Store

# Cachés descargados de martj42 (regenerables vía fetch_martj42; no son fuente de verdad).
data/raw/results.csv
data/raw/shootouts.csv

# Snapshots live + puntero: estado de corrida regenerable, no fuente de verdad.
data/raw/results_*.parquet
data/raw/latest.txt
