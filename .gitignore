# Environments / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build artifacts (regenerable; not source of truth).
build/
*.egg-info/

# Secrets: NEVER commit the API key
.env

# Derived/run data (regenerable): not versioned. The only versioned input data
# is data/raw/annex_c_2026.json (derived from the regulations, not downloadable).
data/processed/*
!data/processed/.gitkeep

# Outputs: only version "final" figures by hand; everything else is ignored.
outputs/figures/*
outputs/videos/*
!outputs/figures/.gitkeep
!outputs/videos/.gitkeep

# OS
.DS_Store

# Caches downloaded from martj42 (regenerable via fetch_martj42; not source of truth).
data/raw/results.csv
data/raw/shootouts.csv

# Live snapshots + pointer: regenerable run state, not source of truth.
data/raw/results_*.parquet
data/raw/latest.txt
