# Copia este archivo a `.env` y rellena tus claves. `.env` está en .gitignore.
# Las claves se usan server-side; NUNCA se commitean (PROJECT.md §10).

# football-data.org (v4) — proveedor LIVE primario (free, cubre el WC2026 sin límite de
# temporada). Header de auth: X-Auth-Token. Regístrate gratis en:
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# API-Football (api-sports.io) — proveedor alternativo (live.provider: api_football).
# OJO: el tier free NO llega a la temporada 2026. Header: x-apisports-key
API_FOOTBALL_KEY=
