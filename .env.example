# Copia este archivo a `.env` y rellena tus claves. `.env` está en .gitignore.
# Las claves se usan server-side; NUNCA se commitean (PROJECT.md §10).

# API-Football (api-sports.io) — proveedor LIVE primario. Tier free 100 req/día.
# Header de auth: x-apisports-key
API_FOOTBALL_KEY=

# football-data.org — fallback de resultados FINALIZADOS. Header: X-Auth-Token
FOOTBALL_DATA_TOKEN=
